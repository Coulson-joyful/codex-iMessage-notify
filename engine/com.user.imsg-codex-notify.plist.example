<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0"><dict>
  <key>Label</key><string>com.user.imsg-codex-notify</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>__PATH_TO_REPO__/engine/codex-notify-bridge.sh</string></array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/imsg-codex-notify.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/imsg-codex-notify.err.log</string>
</dict></plist>
