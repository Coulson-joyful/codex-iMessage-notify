# Copy to config.env. This file is ignored by Git: never commit real handles.
IMSG_HANDLES="you@example.com,+10000000000"
IMSG_REPLY_TO="you@example.com"
IMSG_NOTIFY_TO="+10000000000"
# Comma-separated command prefixes accepted from your own iMessage handles.
IMSG_COMMAND_PREFIXES="Codex ,Codex 信息："
# Every Codex remote reply begins with this label.
IMSG_REPLY_PREFIX="Codex 信息："
IMSG_REQUIRE_CC=1
IMSG_STRICT_SELF=1
IMSG_POLL_INTERVAL=15
IMSG_CHUNK_SIZE=1200
IMSG_MAX_CHUNKS=10

# iMessage remote execution creates an independent Codex CLI session.
CODEX_BIN="codex"
CODEX_WORKDIR=""
# Safe default: remote commands can inspect but cannot edit. Set workspace-write
# only after reviewing this threat model and keep CODEX_REMOTE_APPROVE=0 by default.
CODEX_REMOTE_SANDBOX="read-only"
CODEX_REMOTE_APPROVE=0

# Desktop hooks write here; the LaunchAgent bridge delivers through Messages.
IMSG_CODEX_QUEUE_DIR=""
IMSG_CODEX_NOTIFY_INTERVAL=2
# Python permitted to read ~/Library/Messages/chat.db. On this Mac, the working
# cc receiver uses Xcode's Python. Set this explicitly if your FDA grant differs.
IMSG_PYTHON_BIN=""
